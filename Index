<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <title>Mobile Dispatch Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    /* Smooth Accordion Animation */
    .folder-content {
      transition: max-height 0.3s ease-in-out, opacity 0.3s ease-in-out;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
    }
    .folder-content.open {
      max-height: 2000px; /* High enough to fit the students */
      opacity: 1;
    }
    .folder-btn svg {
      transition: transform 0.2s;
    }
    .folder-btn.open svg {
      transform: rotate(90deg);
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen pb-12">
  
  <header class="bg-[#2c4c94] text-white px-6 py-6 shadow-md text-center sticky top-0 z-50">
    <h1 id="hub-title" class="text-xl font-bold tracking-tight">Classes by CMA Tarun Singhal Hub</h1>
    <p class="text-blue-200 text-xs mt-1">⚡ Direct CRM WhatsApp Gateway</p>
  </header>

  <main class="max-w-3xl mx-auto px-4 py-6">
    
    <div class="mb-6 relative sticky top-24 z-40">
      <input type="text" id="search-input" placeholder="🔍 Search by Topic, Student Name, or Mobile Number..."
             class="w-full px-4 py-3 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-[#2c4c94] focus:border-[#2c4c94] text-sm"
             onkeyup="filterGroups()">
    </div>

    <div id="loading" class="text-center py-10 text-slate-500 text-sm font-medium">
      <div class="animate-spin inline-block w-6 h-6 border-4 border-[#2c4c94] border-t-transparent rounded-full mb-2"></div><br>
      Pulling latest records & grouping exams...
    </div>
    
    <div id="accordion-container" class="space-y-4"></div>
    
    <div id="no-results" class="hidden text-center py-8 text-slate-500 text-sm">
      No matching records found. Try another search.
    </div>

  </main>

  <script>
    let groupedData = {};

    window.addEventListener('load', function() {
      google.script.run
        .withSuccessHandler(function(rawResponse) {
          const data = JSON.parse(rawResponse);
          if (data.instName) document.getElementById('hub-title').innerText = data.instName + " Hub";
          
          document.getElementById('loading').classList.add('hidden');
          processAndRenderGroups(data.records);
        })
        .withFailureHandler(function(err) {
          document.getElementById('loading').innerText = "Error loading records: " + err.message;
        })
      .getMobileHubData("<?= teacherSheetId ?>");  
    });

    function processAndRenderGroups(records) {
      const container = document.getElementById('accordion-container');
      container.innerHTML = '';
      
      if (records.length === 0) {
        document.getElementById('no-results').classList.remove('hidden');
        return;
      }

      // Group records by Exam Name
      groupedData = {};
      records.forEach(rec => {
        let topic = rec.sheetName;
        if (!groupedData[topic]) groupedData[topic] = [];
        groupedData[topic].push(rec);
      });

      // Render Accordion Folders
      let index = 0;
      for (const [topicName, students] of Object.entries(groupedData)) {
        
        // 🔥 FIX: Lock the current index into a block-scoped variable so the button doesn't lose track of its folder
        const currentIndex = index; 
        
        const folderDiv = document.createElement('div');
        folderDiv.className = "exam-folder bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden";
        folderDiv.setAttribute('data-topic', topicName.toLowerCase());

        // Header Button
        const headerBtn = document.createElement('button');
        headerBtn.className = "folder-btn w-full px-5 py-4 flex justify-between items-center bg-slate-50 hover:bg-slate-100 transition text-left border-b border-transparent focus:outline-none";
        
        // 🔥 FIX: Apply the locked index variable
        headerBtn.onclick = function() { toggleAccordion(this, `content-${currentIndex}`); };
        
        headerBtn.innerHTML = `
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-slate-400 flex-shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            <span class="font-bold text-slate-800 text-sm leading-snug pr-2">${topicName}</span>
          </div>
          <span class="flex-shrink-0 text-[11px] font-semibold bg-[#e0e7ff] text-[#3730a3] px-2 py-1 rounded-full">${students.length} Submissions</span>
        `;

        // Content Area (Hidden by default)
        const contentDiv = document.createElement('div');
        contentDiv.id = `content-${currentIndex}`;
        contentDiv.className = "folder-content bg-white";

        let studentHTML = '<div class="p-4 space-y-4">';
        
        students.forEach(student => {
          let dateStr = "Unknown Date";
          if (student.timestamp > 0) {
            const d = new Date(student.timestamp);
            dateStr = d.toLocaleString('en-IN', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
          }

          studentHTML += `
            <div class="student-card bg-slate-50 rounded-lg p-4 border border-slate-100 flex flex-col gap-3" 
                 data-name="${student.studentName.toLowerCase()}" 
                 data-mobile="${student.mobile}">
              
              <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-2">
                <div>
                  <h4 class="font-bold text-slate-900 text-sm">👤 ${student.studentName}</h4>
                  <div class="flex gap-3 mt-1">
                    <span class="text-[11px] font-medium text-slate-500">📱 ${student.mobile}</span>
                    <span class="text-[11px] font-medium text-slate-400">🕒 ${dateStr}</span>
                  </div>
                </div>
              </div>
              
              <a href="${student.waUrl}" target="_blank" class="w-full sm:w-auto bg-[#48bb78] hover:bg-[#38a169] text-white font-bold py-2 px-4 rounded shadow-sm text-xs text-center transition flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                Send Scorecard
              </a>
            </div>`;
        });
        
        studentHTML += '</div>';
        contentDiv.innerHTML = studentHTML;

        folderDiv.appendChild(headerBtn);
        folderDiv.appendChild(contentDiv);
        container.appendChild(folderDiv);
        
        index++;
      }
    }

    // Toggle logic for the accordion folders
    function toggleAccordion(btn, contentId) {
      const content = document.getElementById(contentId);
      if (!content) return; // Fail-safe
      
      btn.classList.toggle('open');
      content.classList.toggle('open');
      if (btn.classList.contains('open')) {
        btn.classList.add('border-slate-200');
      } else {
        btn.classList.remove('border-slate-200');
      }
    }

    // 🔍 OMNI-SEARCH LOGIC
    function filterGroups() {
      const query = document.getElementById('search-input').value.toLowerCase();
      const folders = document.querySelectorAll('.exam-folder');
      let totalVisibleFolders = 0;

      folders.forEach(folder => {
        const topicName = folder.getAttribute('data-topic');
        const students = folder.querySelectorAll('.student-card');
        
        let folderMatches = topicName.includes(query);
        let hasVisibleStudent = false;

        students.forEach(student => {
          const name = student.getAttribute('data-name');
          const mobile = student.getAttribute('data-mobile');
          
          if (folderMatches || name.includes(query) || mobile.includes(query)) {
            student.style.display = 'flex';
            hasVisibleStudent = true;
          } else {
            student.style.display = 'none';
          }
        });

        if (hasVisibleStudent) {
          folder.style.display = 'block';
          totalVisibleFolders++;
          
          const btn = folder.querySelector('.folder-btn');
          const content = folder.querySelector('.folder-content');
          if (query.length > 0 && !folderMatches) {
            btn.classList.add('open');
            content.classList.add('open');
          } else if (query.length === 0) {
            btn.classList.remove('open');
            content.classList.remove('open');
          }
        } else {
          folder.style.display = 'none';
        }
      });

      document.getElementById('no-results').classList.toggle('hidden', totalVisibleFolders > 0);
    }
  </script>
</body>
</html>
